rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'paineiras2011@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public readable reviews, writable by app
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // Public readable comparison guides, writable by app
    match /guides/{guideId} {
      allow read: if true;
      allow write: if true;
    }

    // Public readable categories, writable by app
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Public readable banners, writable by app
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Public readable site settings, writable by app
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Outbound affiliate click tracking
    match /affiliateClicks/{clickId} {
      allow read, write: if true;
    }

    // Admins list
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
