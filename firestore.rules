rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'paineiras2011@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public readable reviews, admin manageable
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public readable categories, admin manageable
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public readable banners, admin manageable
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public readable site settings, admin manageable
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Outbound affiliate click tracking
    match /affiliateClicks/{clickId} {
      allow read: if isAdmin();
      allow create: if isValidId(clickId) && request.resource.data.size() <= 10;
      allow update, delete: if isAdmin();
    }

    // Admins list
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
